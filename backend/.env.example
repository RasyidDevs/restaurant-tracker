# Salin ke backend/.env lalu isi. File .env TIDAK boleh di-commit (sudah di .gitignore).
#
# Opsional: lapisan LLM untuk ringkasan saran tindakan (AI Insight).
# Kosongkan ANTHROPIC_API_KEY -> sistem tetap jalan memakai rule-based engine saja.
ANTHROPIC_API_KEY=
# Model Claude yang dipakai (default: claude-haiku-5-5, murah & cepat)
LLM_MODEL=claude-haiku-5-5
# Seberapa sering ringkasan LLM diperbarui (detik)
LLM_REFRESH_S=60
